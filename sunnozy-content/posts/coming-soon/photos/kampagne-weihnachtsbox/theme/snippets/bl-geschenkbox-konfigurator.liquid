{%- comment -%}
  Personalisierte Geschenkbox (sunnozy): Sets auswaehlen, Karte, Name und Wunschtext.
  Summe: nur der Totalpreis (Sets + Box) wird angezeigt.
  v2 (19.10.2026): zwei Dropdowns mit Mehrfachauswahl (1. Produkte, 2. Groessen). Daraus entsteht die Liste
  «Deine Auswahl»: jede Kombination Produkt + Groesse mit Haekchen und Anzahl (- / +), einzeln entfernbar.
  Produkte ohne Groessen (nur eine Variante, z.B. Mulltuecher, Halstuecher) erscheinen immer als «Einheitsgrösse».
  Legt die gewaehlten Varianten (mit Anzahl) und die Box (Produkt mit Preis CHF 15 fuer Box, Seidenpapier, Karte,
  Einpacken) zusammen in den Warenkorb. Alle Teile einer Box tragen dieselbe versteckte Eigenschaft _Geschenkbox,
  die Box selbst traegt Inhalt, Karte, Name und Wunschtext als sichtbare Eigenschaften.
  Auswahl: Kollektion «geschenkbox-auswahl» (Body-Sets, Hosen-Sets, Mulltuecher, Halstuecher).
  Aufruf: {% render 'bl-geschenkbox-konfigurator', product: product %}
{%- endcomment -%}
{%- assign auswahl = collections['geschenkbox-auswahl'] -%}
{%- assign box_variant = product.selected_or_first_available_variant -%}
<div class="bl-gbk" data-box-variant="{{ box_variant.id }}" data-box-price="{{ box_variant.price }}" data-currency="{{ cart.currency.iso_code }}">
  <script type="application/json" data-bl-gbk-daten>
    [
    {%- assign erstes = true -%}
    {%- for p in auswahl.products limit: 60 -%}
      {%- if p.available -%}
        {%- unless erstes -%},{%- endunless -%}{%- assign erstes = false -%}
        {"titel": {{ p.title | json }}, "bild": {% if p.featured_image %}{{ p.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %},
         "einheit": {{ p.has_only_default_variant | json }},
         "varianten": [
          {%- for v in p.variants -%}
            {"id": {{ v.id }}, "groesse": {{ v.option1 | json }}, "preis": {{ v.price }}, "da": {{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
         ]}
      {%- endif -%}
    {%- endfor -%}
    ]
  </script>

  <p class="bl-gbk__schritt">1. Sets auswählen</p>
  <p class="bl-gbk__hinweis">Wähle ein oder mehrere Produkte und eine oder mehrere Grössen. Alles kommt zusammen in eine Box.</p>

  <div class="bl-gbk__dds">
    <div class="bl-gbk__dd" data-dd="produkte">
      <button type="button" class="bl-gbk__dd-knopf" aria-expanded="false">
        <span class="bl-gbk__dd-text" data-leer="Produkte auswählen">Produkte auswählen</span>
        <span class="bl-gbk__pfeil" aria-hidden="true"></span>
      </button>
      <div class="bl-gbk__dd-liste" role="listbox" aria-multiselectable="true" hidden></div>
    </div>
    <div class="bl-gbk__dd" data-dd="groessen">
      <button type="button" class="bl-gbk__dd-knopf" aria-expanded="false">
        <span class="bl-gbk__dd-text" data-leer="Grössen auswählen">Grössen auswählen</span>
        <span class="bl-gbk__pfeil" aria-hidden="true"></span>
      </button>
      <div class="bl-gbk__dd-liste" role="listbox" aria-multiselectable="true" hidden></div>
    </div>
  </div>

  <div class="bl-gbk__auswahl" aria-live="polite">
    <p class="bl-gbk__auswahl-titel">Deine Auswahl</p>
    <ul class="bl-gbk__zeilen"></ul>
    <p class="bl-gbk__leer">Noch nichts ausgewählt.</p>
  </div>

  <p class="bl-gbk__schritt">2. Karte und Gruss</p>
  <label class="bl-gbk__zeile"><input type="checkbox" class="bl-gbk__karte" checked> Weihnachtskarte «Merry Christmas» beilegen (inklusive)</label>
  <label class="bl-gbk__feld">Name (für wen ist die Box?)
    <input type="text" class="bl-gbk__name" maxlength="40" placeholder="z.B. Lina">
  </label>
  <label class="bl-gbk__feld">Dein Wunschtext für die Karte
    <textarea class="bl-gbk__text" maxlength="200" rows="3" placeholder="z.B. Frohe Weihnachten, kleine Lina! Dein Gotti"></textarea>
    <small class="bl-gbk__zaehler">0 / 200</small>
  </label>

  <div class="bl-gbk__summe">
    <span class="bl-gbk__total">Total: <strong class="bl-gbk__s-total">{{ box_variant.price | money }}</strong></span>
  </div>
  <button type="button" class="button bl-gbk__knopf">Box in den Warenkorb</button>
  <p class="bl-gbk__fehler" role="alert" hidden></p>
</div>

<style>
  .bl-gbk { display: grid; gap: 14px; }
  .bl-gbk__schritt { font-weight: 700; margin: 8px 0 0; }
  .bl-gbk__hinweis { margin: 0; opacity: .75; font-size: .92em; }
  .bl-gbk__dds { display: grid; gap: 10px; }
  @media (min-width: 750px) { .bl-gbk__dds { grid-template-columns: 3fr 2fr; } }
  .bl-gbk__dd { position: relative; }
  .bl-gbk__dd-knopf { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 16px;
    background: #fff; border: 1px solid #233029; border-radius: 10px; font: inherit; color: #233029; cursor: pointer; text-align: left; }
  .bl-gbk__dd-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bl-gbk__pfeil { flex: 0 0 auto; width: 8px; height: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg) translateY(-3px); transition: transform .2s; }
  .bl-gbk__dd-knopf[aria-expanded="true"] .bl-gbk__pfeil { transform: rotate(-135deg) translateY(-2px); }
  .bl-gbk__dd-liste { margin-top: 6px; max-height: 360px; overflow: auto;
    background: #fff; border: 1px solid rgb(0 0 0 / .15); border-radius: 10px; box-shadow: 0 8px 20px rgb(0 0 0 / .08); padding: 6px; }
  .bl-gbk__dd-liste:not([hidden]) { display: grid; }
  .bl-gbk__fertig { position: sticky; bottom: 0; margin-top: 4px; padding: 10px; border: 0; border-radius: 8px; background: #233029; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  @media (min-width: 750px) { .bl-gbk__dds { align-items: start; } }
  .bl-gbk__opt { display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 8px; cursor: pointer; font-size: .92em; line-height: 1.3; }
  .bl-gbk__opt:hover { background: #f6f0e8; }
  .bl-gbk__opt input { flex: 0 0 auto; width: 18px; height: 18px; accent-color: #233029; margin: 0; }
  .bl-gbk__opt img { flex: 0 0 auto; width: 40px; height: 40px; object-fit: contain; background: #fff; border-radius: 4px; }
  .bl-gbk__opt-titel { flex: 1 1 auto; }
  .bl-gbk__opt-preis { flex: 0 0 auto; font-weight: 700; white-space: nowrap; }
  .bl-gbk__auswahl { display: grid; gap: 8px; padding: 12px; border: 1px solid rgb(0 0 0 / .12); border-radius: 10px; background: #fff; }
  .bl-gbk__auswahl-titel { margin: 0; font-weight: 700; font-size: .92em; }
  .bl-gbk__zeilen { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .bl-gbk__leer { margin: 0; font-size: .9em; opacity: .7; }
  .bl-gbk__z { display: grid; grid-template-columns: 22px 44px minmax(0, 1fr) auto auto; align-items: center; gap: 10px; padding: 8px; background: #f6f0e8; border-radius: 8px; font-size: .9em; }
  .bl-gbk__haken { width: 22px; height: 22px; border-radius: 50%; background: #233029; color: #fff; display: grid; place-items: center; font-size: 13px; line-height: 1; }
  .bl-gbk__z img { width: 44px; height: 44px; object-fit: contain; background: #fff; border-radius: 4px; }
  .bl-gbk__z-titel { line-height: 1.3; }
  .bl-gbk__z-titel small { display: block; opacity: .75; }
  .bl-gbk__menge { display: inline-flex; align-items: center; border: 1px solid rgb(0 0 0 / .2); border-radius: 999px; background: #fff; }
  .bl-gbk__menge button { width: 30px; height: 30px; border: 0; background: none; font-size: 17px; cursor: pointer; color: #233029; }
  .bl-gbk__menge input { width: 30px; border: 0; text-align: center; font: inherit; background: none; -moz-appearance: textfield; }
  .bl-gbk__menge input::-webkit-inner-spin-button { -webkit-appearance: none; }
  .bl-gbk__weg { border: 0; background: none; font-size: 20px; line-height: 1; cursor: pointer; opacity: .55; padding: 4px; }
  .bl-gbk__weg:hover { opacity: 1; }
  .bl-gbk__info { margin: 0; font-size: .85em; color: #8a5a00; }
  @media (max-width: 480px) {
    .bl-gbk__z { grid-template-columns: 22px 40px minmax(0, 1fr) auto; }
    .bl-gbk__z .bl-gbk__menge { grid-column: 3; justify-self: start; }
    .bl-gbk__z .bl-gbk__weg { grid-column: 4; grid-row: 1; }
  }
  .bl-gbk__zeile { display: flex; gap: 8px; align-items: center; }
  .bl-gbk__feld { display: grid; gap: 4px; }
  .bl-gbk__feld input, .bl-gbk__feld textarea { width: 100%; padding: 10px; font: inherit; border: 1px solid rgb(0 0 0 / .25); border-radius: 6px; }
  .bl-gbk__zaehler { opacity: .6; justify-self: end; }
  .bl-gbk__summe { display: grid; gap: 4px; padding: 12px; background: #f6f0e8; border-radius: 8px; }
  .bl-gbk__total { font-size: 1.1em; }
  .bl-gbk__knopf { width: 100%; }
  .bl-gbk__fehler { color: #a3262a; margin: 0; }
</style>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling.previousElementSibling;
    if (!root || !root.classList.contains('bl-gbk')) return;
    const waehrung = root.dataset.currency || 'CHF';
    const boxPreis = Number(root.dataset.boxPrice || 0);
    const geld = (c) => `${waehrung} ${(c / 100).toFixed(2)}`;
    const esc = (s) => String(s).replace(/[&<>"]/g, (z) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[z]));
    let produkte = [];
    try { produkte = JSON.parse(root.querySelector('[data-bl-gbk-daten]').textContent); } catch (e) {}
    // Groessen enthalten Ziffern (0-3 Monate, 56/62). Produkte mit Design-Varianten (z.B. Halstuecher «Mummy Rosa»)
    // erscheinen je Design als eigener Eintrag im Produkt-Dropdown, ohne Groesse.
    const istGroesse = (s) => /\d/.test(s || '');
    produkte = produkte.flatMap((p) => {
      if (p.einheit || p.varianten.some((v) => istGroesse(v.groesse))) return [p];
      const da = p.varianten.filter((v) => v.da);
      if (da.length <= 1) return [{ ...p, einheit: true, varianten: da.length ? da : p.varianten }];
      return da.map((v) => ({ ...p, titel: `${p.titel} – ${v.groesse}`, einheit: true, varianten: [v] }));
    });
    produkte.forEach((p, i) => { p.i = i; });
    const EINHEIT = 'Einheitsgrösse';
    // Groessen in Shop-Reihenfolge (erste Fundstelle), nur von Produkten mit Groessen
    const groessen = [];
    produkte.forEach((p) => { if (!p.einheit) p.varianten.forEach((v) => { if (v.da && istGroesse(v.groesse) && !groessen.includes(v.groesse)) groessen.push(v.groesse); }); });

    const gewP = new Set(); const gewG = new Set(); const mengen = new Map();
    const ddP = root.querySelector('[data-dd="produkte"]'); const ddG = root.querySelector('[data-dd="groessen"]');
    const zeilen = root.querySelector('.bl-gbk__zeilen'); const leer = root.querySelector('.bl-gbk__leer');
    const text = root.querySelector('.bl-gbk__text'); const fehler = root.querySelector('.bl-gbk__fehler');

    const FERTIG = '<button type="button" class="bl-gbk__fertig" data-fertig>Fertig</button>';
    const abPreis = (p) => Math.min(...p.varianten.filter((v) => v.da).map((v) => v.preis));
    ddP.querySelector('.bl-gbk__dd-liste').innerHTML = produkte.map((p) =>
      `<label class="bl-gbk__opt"><input type="checkbox" value="${p.i}">${p.bild ? `<img src="${esc(p.bild)}" alt="" loading="lazy" width="40" height="40">` : ''}` +
      `<span class="bl-gbk__opt-titel">${esc(p.titel)}</span><span class="bl-gbk__opt-preis">${p.einheit ? '' : 'ab '}${geld(abPreis(p))}</span></label>`).join('') + FERTIG;
    ddG.querySelector('.bl-gbk__dd-liste').innerHTML = groessen.map((g) =>
      `<label class="bl-gbk__opt"><input type="checkbox" value="${esc(g)}"><span class="bl-gbk__opt-titel">${esc(g)}</span></label>`).join('') + FERTIG;

    function beschriften(dd, set, namen, einzahl, mehrzahl) {
      const t = dd.querySelector('.bl-gbk__dd-text');
      if (!set.size) t.textContent = t.dataset.leer;
      else if (set.size === 1) t.textContent = namen[0];
      else t.textContent = `${set.size} ${mehrzahl} gewählt`;
    }

    // Kombinationen Produkt x Groesse
    function positionen() {
      const out = [];
      produkte.filter((p) => gewP.has(p.i)).forEach((p) => {
        if (p.einheit) {
          const v = p.varianten[0];
          if (v.da) out.push({ p, v, groesse: EINHEIT });
          return;
        }
        gewG.forEach((g) => { const v = p.varianten.find((x) => x.groesse === g && x.da); if (v) out.push({ p, v, groesse: g }); });
      });
      return out;
    }

    function zeichnen() {
      beschriften(ddP, gewP, produkte.filter((p) => gewP.has(p.i)).map((p) => p.titel), 'Produkt', 'Produkte');
      beschriften(ddG, gewG, [...gewG], 'Grösse', 'Grössen');
      const pos = positionen();
      const brauchtGroesse = produkte.some((p) => gewP.has(p.i) && !p.einheit);
      const fehlend = [];
      produkte.filter((p) => gewP.has(p.i) && !p.einheit).forEach((p) => {
        gewG.forEach((g) => { if (!p.varianten.some((x) => x.groesse === g && x.da)) fehlend.push(`${p.titel} (${g})`); });
      });
      zeilen.innerHTML = pos.map(({ p, v, groesse }) => {
        const m = mengen.get(v.id) || 1; mengen.set(v.id, m);
        return `<li class="bl-gbk__z" data-v="${v.id}"><span class="bl-gbk__haken" aria-hidden="true">✓</span>` +
          `${p.bild ? `<img src="${esc(p.bild)}" alt="" width="44" height="44">` : '<span></span>'}` +
          `<span class="bl-gbk__z-titel">${esc(p.titel)}<small>${esc(groesse)} · ${geld(v.preis)}</small></span>` +
          `<span class="bl-gbk__menge"><button type="button" data-minus aria-label="Weniger">−</button>` +
          `<input type="number" min="1" max="10" value="${m}" aria-label="Anzahl"><button type="button" data-plus aria-label="Mehr">+</button></span>` +
          `<button type="button" class="bl-gbk__weg" data-weg aria-label="Entfernen">×</button></li>`;
      }).join('') +
        (brauchtGroesse && !gewG.size ? '<li><p class="bl-gbk__info">Bitte wähle noch mindestens eine Grösse.</p></li>' : '') +
        (fehlend.length ? `<li><p class="bl-gbk__info">Nicht verfügbar: ${esc(fehlend.join(', '))}</p></li>` : '');
      leer.hidden = !!(pos.length || gewP.size);
      rechnen();
    }

    function gewaehlt() {
      return positionen().map(({ p, v, groesse }) => ({ id: v.id, preis: v.preis, name: p.titel, groesse, menge: mengen.get(v.id) || 1 }));
    }

    function rechnen() {
      const g = gewaehlt();
      const summe = g.reduce((a, x) => a + x.preis * x.menge, 0);
      root.querySelector('.bl-gbk__s-total').textContent = geld(summe + boxPreis);
    }

    // Dropdowns oeffnen / schliessen
    [ddP, ddG].forEach((dd) => {
      const knopf = dd.querySelector('.bl-gbk__dd-knopf'); const liste = dd.querySelector('.bl-gbk__dd-liste');
      liste.addEventListener('click', (e) => { if (e.target.closest('[data-fertig]')) { liste.hidden = true; knopf.setAttribute('aria-expanded', 'false'); } });
      knopf.addEventListener('click', () => {
        const auf = liste.hidden;
        [ddP, ddG].forEach((d) => { d.querySelector('.bl-gbk__dd-liste').hidden = true; d.querySelector('.bl-gbk__dd-knopf').setAttribute('aria-expanded', 'false'); });
        liste.hidden = !auf; knopf.setAttribute('aria-expanded', String(auf));
      });
    });
    document.addEventListener('click', (e) => {
      if (e.target.closest('.bl-gbk__dd')) return;
      [ddP, ddG].forEach((d) => { d.querySelector('.bl-gbk__dd-liste').hidden = true; d.querySelector('.bl-gbk__dd-knopf').setAttribute('aria-expanded', 'false'); });
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') [ddP, ddG].forEach((d) => { d.querySelector('.bl-gbk__dd-liste').hidden = true; }); });

    ddP.addEventListener('change', (e) => { const i = Number(e.target.value); e.target.checked ? gewP.add(i) : gewP.delete(i); zeichnen(); });
    ddG.addEventListener('change', (e) => { const g = e.target.value; e.target.checked ? gewG.add(g) : gewG.delete(g); zeichnen(); });

    zeilen.addEventListener('click', (e) => {
      const z = e.target.closest('.bl-gbk__z'); if (!z) return;
      const id = Number(z.dataset.v); const inp = z.querySelector('input');
      if (e.target.closest('[data-plus]')) { mengen.set(id, Math.min(10, (mengen.get(id) || 1) + 1)); inp.value = mengen.get(id); rechnen(); }
      else if (e.target.closest('[data-minus]')) { mengen.set(id, Math.max(1, (mengen.get(id) || 1) - 1)); inp.value = mengen.get(id); rechnen(); }
      else if (e.target.closest('[data-weg]')) {
        // Ganze Zeile entfernen: bei Einheitsgroesse das Produkt abwaehlen, sonst nur diese Groesse fuer dieses Produkt ausblenden
        const p = produkte.find((x) => x.varianten.some((v) => v.id === id));
        if (p.einheit || ![...gewG].some((g) => p.varianten.some((v) => v.groesse === g && v.da && v.id !== id))) {
          gewP.delete(p.i); ddP.querySelector(`input[value="${p.i}"]`).checked = false;
        } else {
          p.ohne = p.ohne || new Set(); p.ohne.add(id);
        }
        zeichnen();
      }
    });
    zeilen.addEventListener('change', (e) => {
      const z = e.target.closest('.bl-gbk__z'); if (!z) return;
      const n = Math.max(1, Math.min(10, parseInt(e.target.value, 10) || 1)); e.target.value = n; mengen.set(Number(z.dataset.v), n); rechnen();
    });

    // Einzeln entfernte Kombinationen aus der Liste halten, bis Produkt oder Groesse neu gewaehlt wird
    const posAlt = positionen;
    positionen = () => posAlt().filter(({ p, v }) => !(p.ohne && p.ohne.has(v.id)));
    ddP.addEventListener('change', (e) => { const p = produkte[Number(e.target.value)]; if (p) p.ohne = null; }, true);
    ddG.addEventListener('change', () => produkte.forEach((p) => { p.ohne = null; }), true);

    text.addEventListener('input', () => { root.querySelector('.bl-gbk__zaehler').textContent = `${text.value.length} / 200`; });

    root.querySelector('.bl-gbk__knopf').addEventListener('click', async (e) => {
      const g = gewaehlt();
      fehler.hidden = true;
      if (!g.length) {
        fehler.textContent = gewP.size ? 'Bitte wähle eine Grösse für Deine Sets.' : 'Bitte wähle mindestens ein Produkt für die Box.';
        fehler.hidden = false; return;
      }
      const nr = `GB-${Date.now().toString(36).toUpperCase()}`;
      const name = root.querySelector('.bl-gbk__name').value.trim();
      const wunsch = text.value.trim();
      const boxEig = { 'Inhalt': g.map((x) => `${x.menge} × ${x.name} (${x.groesse})`).join('; '),
                       'Karte': root.querySelector('.bl-gbk__karte').checked ? 'Ja' : 'Nein', '_Geschenkbox': nr };
      if (name) boxEig['Name'] = name;
      if (wunsch) boxEig['Wunschtext'] = wunsch;
      const items = g.map((x) => ({ id: x.id, quantity: x.menge, properties: { '_Geschenkbox': nr } }));
      items.push({ id: Number(root.dataset.boxVariant), quantity: 1, properties: boxEig });
      const knopf = e.currentTarget; knopf.disabled = true;
      try {
        const basis = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
        const r = await fetch(`${basis}cart/add.js`, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items }) });
        if (!r.ok) { const d = await r.json().catch(() => ({})); throw new Error(d.description || 'Das hat nicht geklappt.'); }
        window.location.href = `${basis}cart`;
      } catch (err) {
        fehler.textContent = err.message; fehler.hidden = false; knopf.disabled = false;
      }
    });
    zeichnen();
  })();
</script>

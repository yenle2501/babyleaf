# Kopieren nach .env und ausfüllen. .env wird NIE committet.
RICARDO_EMAIL=
RICARDO_PASSWORD=
# true = Browser unsichtbar (erst nach dem ersten erfolgreichen Login empfohlen)
RICARDO_HEADLESS=false
# Optional: eigener Pfad für das Browser-Profil (Cookies/Session)
# RICARDO_PROFILE_DIR=
# Optional: "chrome" nutzt das installierte Google Chrome (kommt oft besser durch die Captcha)
# RICARDO_BROWSER_CHANNEL=chrome
